# ---- Umumy ----
APP_ENV=prod
PUBLIC_URL=https://os.astu.tm
COOKIE_SECURE=true
POSTGRES_PASSWORD=uytget-meni-uzyn-gizlin-parol

# Ilkinji administrator (ilkinji işledilende döredilýär)
ADMIN_EMAIL=admin@astu.tm
ADMIN_PASSWORD=uytget-meni-admin-parol

# ---- Proxmox ----
# fake = Proxmox-syz synag (API we worker bir prosesde bolmaly: RUN_WORKER=true)
HYPERVISOR=proxmox
PVE_URL=https://10.0.0.10:8006
PVE_TOKEN_ID=panel@pve!api
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Proxmox-yň öz sertifikaty: ýa CA faýly (has gowy), ýa-da içki torda PVE_INSECURE_TLS=true
PVE_CA_FILE=/certs/pve-root-ca.pem
PVE_INSECURE_TLS=false
# Şablondaky esasy diskiň ady
PVE_DISK=scsi0
# Her VM-e IP/MAC filtri we çykýan 25-nji port bloky
PVE_FIREWALL=true
# Ulanyjy bekaplary üçin storage ("Backup" content açyk bolmaly) we bir maşyn üçin iň köp bekap sany
PVE_BACKUP_STORAGE=local
BACKUP_LIMIT=3

# ---- Billing ----
# Maşyn açmak üçin balans azyndan şunça sagatlyk tutuma ýetmeli.
# Balans 0-dan aşak düşende serwerler öçürilýär we doldurylanda açylýar (awtomatik pozulmaýar).
MIN_CREDIT_HOURS=24
# Balans sahypasynda görkezilýän töleg rekwizitleri (bank hasaby, kassa salgysy)
PAYMENT_INFO=

# ---- Email (boş bolsa, hatlar diňe loga ýazylýar) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@os.astu.tm
